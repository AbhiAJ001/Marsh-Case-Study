# ─── Marsh Pitch Generator — API Keys ─────────────────────────────────
# Copy this file to ".env" and fill in at least ONE key.
# The system uses a multi-model fallback chain — one key is enough to run.
#
# Free keys you can get immediately:
#   Groq (fast, free):    https://console.groq.com
#   OpenRouter (free models): https://openrouter.ai
#   Google Gemini:        https://aistudio.google.com
# ─────────────────────────────────────────────────────────────────────────

# Google Gemini (free quota available)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq — very fast inference, generous free tier
GROQ_API_KEY=your_groq_api_key_here

# Mistral AI
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_KEY_2=your_second_mistral_key_here

# OpenRouter — routes to many open-source models for free
OPENROUTER_API_KEY=your_openrouter_key_here
OPENROUTER_API_KEY_2=your_second_openrouter_key_here

# NVIDIA NIM (optional)
NVIDIA_API_KEY=your_nvidia_nim_key_here
